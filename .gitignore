.env
__pycache__/
*.pyc
usage.jsonl
PAUSE
errors.jsonl
monitor.log
.run.lock
# Raw provider request logs stay local. Scored results, records, and summaries are saved
# separately, and analysis never reads these logs. Logs committed before this rule stay tracked.
studies/subagent-rule-updates/results/*/*/requests.jsonl*
# Files restored from archived studies' artifacts.tar.gz (see studies/compaction-survey/shared/artifacts.py).
studies/compaction-survey/[ex][0-9][0-9]_*/*/
