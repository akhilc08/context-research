.env
__pycache__/
*.pyc
usage.jsonl
PAUSE
errors.jsonl
monitor.log
.run.lock
# Long compaction runs keep raw request logs (hundreds of MB) local.
# Scored requests and summarizer calls are already in each run's result and record files.
experiments/subagent-rule-updates/results/compaction-*/*/requests.jsonl*
!experiments/subagent-rule-updates/results/compaction-00[12]/*/requests.jsonl*
# A run in progress is committed only once it finishes.
experiments/subagent-rule-updates/results/compaction-006/
